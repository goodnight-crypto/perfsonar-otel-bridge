{
  "name": "パケットロス率 — 経路別",
  "description": "実測では LAN は 24h 全て 0、wan-blog のみ 0.1 の単発スパイクが1回。Detector は単発で発火させない（2点連続）",
  "programText": "loss = data('perfsonar.packet.loss.ratio').mean(by=['path.id', 'ps.source', 'ps.destination']).publish(label='loss')",
  "options": {
    "type": "TimeSeriesChart",
    "unitPrefix": "Metric",
    "colorBy": "Dimension",
    "defaultPlotType": "ColumnChart",
    "showEventLines": false,
    "stacked": false,
    "time": { "type": "relative", "range": 86400000, "rangeEnd": 0 },
    "axes": [
      {
        "label": "ratio (0–1)",
        "min": 0,
        "highWatermark": 0.01,
        "highWatermarkLabel": "Detector 閾値 1%"
      },
      { "label": "" }
    ],
    "legendOptions": {
      "fields": [
        { "property": "path.id", "enabled": true },
        { "property": "ps.source", "enabled": true },
        { "property": "ps.destination", "enabled": true }
      ]
    },
    "publishLabelOptions": [
      { "label": "loss", "displayName": "packet loss ratio", "plotType": "ColumnChart", "yAxis": 0 }
    ]
  }
}
