{
  "name": "perfSONAR home lab — network SLO",
  "description": "perfSONAR → ブリッジ → OTel Collector → Splunk O11y のパイプラインで観測している自宅ラボの定点観測。測定定義の正は deploy/psconfig/home-lab-mesh.json、変換仕様は docs/schema.md",
  "layout": [
    { "chart": "slo-baseline-ratio", "row": 0, "column": 0, "width": 12, "height": 2 },
    { "chart": "slo-baseline-ratio-zoom", "row": 2, "column": 0, "width": 12, "height": 2 },
    { "chart": "lan-rtt", "row": 4, "column": 0, "width": 6, "height": 1 },
    { "chart": "wan-rtt", "row": 4, "column": 6, "width": 6, "height": 1 },
    { "chart": "twamp-delay-gated", "row": 5, "column": 0, "width": 12, "height": 2 },
    { "chart": "wan-owd", "row": 7, "column": 0, "width": 12, "height": 2 },
    { "chart": "packet-loss", "row": 9, "column": 0, "width": 6, "height": 1 },
    { "chart": "throughput", "row": 9, "column": 6, "width": 6, "height": 1 },
    { "chart": "throughput-retransmits", "row": 10, "column": 0, "width": 6, "height": 1 },
    { "chart": "trace-hops", "row": 10, "column": 6, "width": 6, "height": 1 }
  ],
  "eventOverlays": [
    { "detector": "lan-rtt-degraded", "label": "LAN RTT 劣化" },
    { "detector": "lan-throughput-degraded", "label": "LAN スループット劣化" },
    { "detector": "wan-rtt-sudden-change", "label": "WAN RTT 逸脱" },
    { "detector": "packet-loss", "label": "パケットロス継続" }
  ]
}
